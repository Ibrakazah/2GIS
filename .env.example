# --- Nemotron Ultra через OpenRouter (сейчас) ---
AI_API_KEY=sk-or-v1-...вставь-сюда...
AI_API_BASE=https://openrouter.ai/api/v1
# ультра бесплатно: nvidia/nemotron-3-ultra-550b-a55b:free | платно: nvidia/nemotron-3-ultra-550b-a55b
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# запасные модели если основная уперлась в лимит (через запятую)
AI_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b,qwen/qwen3.8-27b
# --- Groq (запасной) ---
# AI_API_KEY=gsk_...вставь-сюда...
# AI_API_BASE=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
# LIVE-режим: отзывы всегда свежие с 2ГИС, без базы отзывов (SQLite только для черновиков ИИ)
LIVE_MODE=1
LIVE_CACHE_TTL=60
# автогенерация для новых отзывов
AUTO_GEN_ENABLED=1
AUTO_CHECK_MINUTES=15
AUTO_MAX_PER_RUN=10
